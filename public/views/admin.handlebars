<div class="row">
    <h2>Контролен панел</h2>
</div>
<div class="row">
    <nav aria-label="breadcrumb"><ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/#/">Начало</a></li>
        <li class="breadcrumb-item active" aria-current="page">Контролен панел</li>
    </ol></nav>
</div>
<div class="card card-body">
    <form id="user-rights" class="form-horizontal">
        <fieldset>
            <legend><span class="fa">&#xf044;</span> Редактиране правата на потребител</legend>
            <div class="row mb-3">
                <label for="id" class="col-md-2 col-form-label">UID</label>
                <div class="col-md-10">
                    <input class="form-control" id="user-id" placeholder="" type="text" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-2 col-form-label">Права</div>
                <div class="col-md-10">
                    <div class="form-check"><input class="form-check-input" name="rights" id="rights-read" value="read" checked="" type="radio" /><label class="form-check-label" for="rights-read">Четене</label></div>
                    <div class="form-check"><input class="form-check-input" name="rights" id="rights-write" value="write" type="radio" /><label class="form-check-label" for="rights-write">Запис</label></div>
                    <div class="form-check"><input class="form-check-input" name="rights" id="rights-both" value="both" type="radio" /><label class="form-check-label" for="rights-both">Четене и запис</label></div>
                </div>
            </div>
        </fieldset>
    </form>
    <p class="text-end">
        <button type="button" id="ux-btn-add-rights" class="btn btn-success"><span class="fa">&#xf067;</span> Добавяне</button>
        <button type="button" id="ux-btn-remove-rights" class="btn btn-danger"><span class="fa">&#xf00d;</span> Премахване</button>
    </p>
</div>